# Local environment and secrets
.env
.env.*
!.env.example
secrets/
*.key
*.pem
wg*.conf

# Gateway monitoring allow-list contains the real private asset inventory.
wireguard/*.list
!wireguard/*.list.example

# Local monitoring inventory: keep only sanitized templates in Git.
prometheus/targets/*.yml
!prometheus/targets/*.yml.example

# Alertmanager configuration contains SMTP passwords and recipient addresses.
alertmanager/alertmanager.yml
!alertmanager/alertmanager.yml.example

# Runtime data
prometheus/data/
prometheus/date/
grafana/data/
grafana/logs/
grafana/plugins/
*.db
*.log

# Backups and temporary files
*.bak
*.backup
*.tmp
*~
.DS_Store

# Editor files
.idea/
.vscode/
