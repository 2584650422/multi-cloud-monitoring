{{ define "email.alert" }}

<!-- ========================================================= -->
<!-- Alert Summary -->
<!-- ========================================================= -->

<table width="100%"
       cellpadding="0"
       cellspacing="0"
       border="0"
       style="border-collapse:collapse; margin:0 0 14px 0;">

  <tr>
    <td style="
      padding:12px 14px;
      background:#f7f7f7;
      border-left:4px solid {{ if eq .Status "firing" }}#c62828{{ else }}#2e7d32{{ end }};
      font-size:16px;
      font-weight:bold;
      line-height:1.5;
    ">
      {{ with index .Annotations "summary" }}
        {{ . }}
      {{ else }}
        {{ with index .Labels "alertname" }}{{ . }}{{ else }}Prometheus Alert{{ end }}
      {{ end }}
    </td>
  </tr>

</table>


<!-- ========================================================= -->
<!-- Alert Information -->
<!-- ========================================================= -->

<div style="
  font-size:14px;
  font-weight:bold;
  margin:18px 0 8px 0;
  color:#333333;
">
  告警信息
</div>

<table width="100%"
       cellpadding="0"
       cellspacing="0"
       border="0"
       style="
         border-collapse:collapse;
         table-layout:fixed;
         margin-bottom:18px;
       ">

  <tr>
    <td style="width:115px; border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>告警级别</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px; word-break:break-all;">
      {{ template "email.severity.value" (index .Labels "severity") }}
    </td>
  </tr>


  {{ with index .Annotations "metric_name" }}
  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>监控指标</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px;">
      {{ . }}
    </td>
  </tr>
  {{ end }}


  {{ with index .Annotations "current_value" }}
  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>
        {{ if eq $.Status "resolved" }}
        最近告警值
        {{ else }}
        当前值
        {{ end }}
      </strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px;">
      {{ . }}
    </td>
  </tr>
  {{ end }}


  {{ with index .Annotations "condition" }}
  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>触发条件</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px;">
      {{ . }}
    </td>
  </tr>
  {{ end }}


  {{ with index .Labels "mountpoint" }}
  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>挂载点</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px; word-break:break-all;">
      {{ . }}
    </td>
  </tr>
  {{ end }}


  {{ with index .Labels "device" }}
  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>磁盘设备</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px; word-break:break-all;">
      {{ . }}
    </td>
  </tr>
  {{ end }}


  {{ with index .Labels "fstype" }}
  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>文件系统</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px;">
      {{ . }}
    </td>
  </tr>
  {{ end }}

</table>


<!-- ========================================================= -->
<!-- Instance Information -->
<!-- ========================================================= -->

<div style="
  font-size:14px;
  font-weight:bold;
  margin:18px 0 8px 0;
  color:#333333;
">
  实例信息
</div>

<table width="100%"
       cellpadding="0"
       cellspacing="0"
       border="0"
       style="
         border-collapse:collapse;
         table-layout:fixed;
         margin-bottom:18px;
       ">

  <tr>
    <td style="width:115px; border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>主机名称</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px; word-break:break-all;">
      {{ with index .Labels "host" }}{{ . }}{{ else }}-{{ end }}
    </td>
  </tr>

  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>环境</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px;">
      {{ template "email.env.value" (index .Labels "env") }}
    </td>
  </tr>

  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>云厂商</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px;">
      {{ template "email.cloud.value" (index .Labels "cloud") }}
    </td>
  </tr>

  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>私网 IP</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px;">
      {{ with index .Labels "private_ip" }}{{ . }}{{ else }}-{{ end }}
    </td>
  </tr>

  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>公网 IP</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px;">
      {{ with index .Labels "public_ip" }}{{ . }}{{ else }}无{{ end }}
    </td>
  </tr>

</table>


<!-- ========================================================= -->
<!-- Time Information -->
<!-- ========================================================= -->

<div style="
  font-size:14px;
  font-weight:bold;
  margin:18px 0 8px 0;
  color:#333333;
">
  时间信息
</div>

<table width="100%"
       cellpadding="0"
       cellspacing="0"
       border="0"
       style="
         border-collapse:collapse;
         table-layout:fixed;
         margin-bottom:18px;
       ">

  <tr>
    <td style="width:115px; border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>触发时间</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px;">
      {{ date "2006-01-02 15:04:05" (tz "Asia/Shanghai" .StartsAt) }}
      （北京时间）
    </td>
  </tr>


  {{ if eq .Status "resolved" }}
  <tr>
    <td style="border:1px solid #dddddd; padding:8px; background:#fafafa;">
      <strong>恢复时间</strong>
    </td>
    <td style="border:1px solid #dddddd; padding:8px;">
      {{ date "2006-01-02 15:04:05" (tz "Asia/Shanghai" .EndsAt) }}
      （北京时间）
    </td>
  </tr>
  {{ end }}

</table>


<!-- ========================================================= -->
<!-- Technical Information -->
<!-- ========================================================= -->

<div style="
  font-size:13px;
  font-weight:bold;
  margin:18px 0 8px 0;
  color:#777777;
">
  技术信息
</div>

<table width="100%"
       cellpadding="0"
       cellspacing="0"
       border="0"
       style="
         border-collapse:collapse;
         table-layout:fixed;
         margin-bottom:24px;
         font-size:12px;
         color:#666666;
       ">

  <tr>
    <td style="width:115px; border:1px solid #e5e5e5; padding:7px; background:#fafafa;">
      <strong>规则标识</strong>
    </td>
    <td style="border:1px solid #e5e5e5; padding:7px; word-break:break-all;">
      {{ with index .Labels "alertname" }}{{ . }}{{ else }}-{{ end }}
    </td>
  </tr>

  <tr>
    <td style="border:1px solid #e5e5e5; padding:7px; background:#fafafa;">
      <strong>采集地址</strong>
    </td>
    <td style="border:1px solid #e5e5e5; padding:7px; word-break:break-all;">
      {{ with index .Labels "instance" }}{{ . }}{{ else }}-{{ end }}
    </td>
  </tr>

</table>

{{ end }}


{{ define "email.html" }}
<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
</head>

<body style="
  margin:0;
  padding:0;
  background:#f5f5f5;
  font-family:Arial, Helvetica, sans-serif;
  font-size:14px;
  color:#333333;
">

<table width="100%"
       cellpadding="0"
       cellspacing="0"
       border="0"
       style="border-collapse:collapse;">

  <tr>
    <td align="center" style="padding:24px 12px;">

      <table width="100%"
             cellpadding="0"
             cellspacing="0"
             border="0"
             style="
               max-width:760px;
               border-collapse:collapse;
               background:#ffffff;
               border:1px solid #e5e5e5;
             ">

        <tr>
          <td style="padding:22px 24px 10px 24px;">

            <div style="
              font-size:22px;
              font-weight:bold;
              margin-bottom:10px;
            ">
              {{ if eq .Status "firing" }}
              Prometheus 告警通知
              {{ else }}
              Prometheus 告警恢复
              {{ end }}
            </div>

            <div style="font-size:14px; color:#666666;">
              当前状态：

              {{ if eq .Status "firing" }}
              <strong style="color:#c62828;">FIRING</strong>
              {{ else }}
              <strong style="color:#2e7d32;">RESOLVED</strong>
              {{ end }}

              &nbsp;&nbsp;

              告警：
              <strong>{{ len .Alerts.Firing }}</strong>

              &nbsp;&nbsp;

              恢复：
              <strong>{{ len .Alerts.Resolved }}</strong>
            </div>

          </td>
        </tr>


        <tr>
          <td style="padding:8px 24px 24px 24px;">


            {{ if gt (len .Alerts.Firing) 0 }}

            <div style="
              color:#c62828;
              font-size:16px;
              font-weight:bold;
              margin:16px 0 14px 0;
            ">
              正在告警（{{ len .Alerts.Firing }}）
            </div>

            {{ range .Alerts.Firing }}
              {{ template "email.alert" . }}
            {{ end }}

            {{ end }}


            {{ if gt (len .Alerts.Resolved) 0 }}

            <div style="
              color:#2e7d32;
              font-size:16px;
              font-weight:bold;
              margin:22px 0 14px 0;
            ">
              已恢复（{{ len .Alerts.Resolved }}）
            </div>

            {{ range .Alerts.Resolved }}
              {{ template "email.alert" . }}
            {{ end }}

            {{ end }}


            <div style="
              border-top:1px solid #eeeeee;
              margin-top:10px;
              padding-top:14px;
              font-size:12px;
              color:#888888;
            ">
              该邮件由 Prometheus + Alertmanager 自动发送。
            </div>

          </td>
        </tr>

      </table>

    </td>
  </tr>

</table>

</body>
</html>
{{ end }}