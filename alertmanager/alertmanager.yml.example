# Copy to alertmanager.yml only on the monitoring host. Never commit the real file:
# it contains SMTP credentials and recipient addresses.
global:
  resolve_timeout: 5m
  smtp_smarthost: "<SMTP_HOST>:<SMTP_PORT>"
  smtp_from: "<ALERT_FROM_ADDRESS>"
  smtp_auth_username: "<SMTP_USERNAME>"
  smtp_auth_password: "<SMTP_AUTH_PASSWORD>"
  smtp_require_tls: true

# The active templates directory must contain exactly one file defining
# email.subject/email.html. Deploy email.tmpl only.
templates:
  - '/etc/alertmanager/templates/*.tmpl'

route:
  receiver: email
  group_by:
    - alertname
    - job
    - host
  group_wait: 10s
  group_interval: 30s
  repeat_interval: 1h

# Critical alerts suppress their corresponding Warning notification. Prometheus
# still evaluates both series; only the lower-severity notification is inhibited.
inhibit_rules:
  # Disk is a filesystem-level alert: / and /data on one host are distinct.
  - source_matchers:
      - alertname="DiskSpaceUsageHigh"
      - severity="critical"
    target_matchers:
      - alertname="DiskSpaceUsageHigh"
      - severity="warning"
    equal:
      - host
      - mountpoint
  # Memory is a host-level alert and has no mountpoint label.
  - source_matchers:
      - alertname="MemoryUsageHigh"
      - severity="critical"
    target_matchers:
      - alertname="MemoryUsageHigh"
      - severity="warning"
    equal:
      - host

receivers:
  - name: email
    email_configs:
      - to: "<ALERT_RECIPIENT_ADDRESS>"
        send_resolved: true
        headers:
          Subject: '{{ template "email.subject" . }}'
        html: '{{ template "email.html" . }}'
