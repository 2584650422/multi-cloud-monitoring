  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "当前公网入带宽（汇总）",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cloud_network_public_receive_mbps{source_timestamped=\"true\",cloud=~\"$cloud\",env=~\"$env\",product=~\"$product\",region=~\"$region\",host=~\"$host\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbps",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "当前公网出带宽（汇总）",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cloud_network_public_transmit_mbps{source_timestamped=\"true\",cloud=~\"$cloud\",env=~\"$env\",product=~\"$product\",region=~\"$region\",host=~\"$host\"})"
