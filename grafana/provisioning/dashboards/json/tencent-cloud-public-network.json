        "name": "host",
        "label": "主机",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "definition": "label_values(cloud_network_public_transmit_mbps{source_timestamped=\"true\",cloud=~\"$cloud\",env=~\"$env\",product=~\"$product\",region=~\"$region\"}, host)",
        "query": {
          "query": "label_values(cloud_network_public_transmit_mbps{source_timestamped=\"true\",cloud=~\"$cloud\",env=~\"$env\",product=~\"$product\",region=~\"$region\"}, host)",
