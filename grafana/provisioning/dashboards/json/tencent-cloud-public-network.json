        "query": {
          "query": "label_values(cloud_network_public_transmit_mbps{source_timestamped=\"true\",cloud=~\"$cloud\",env=~\"$env\"}, product)",
          "refId": "Prometheus-product-Variable-Query"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
